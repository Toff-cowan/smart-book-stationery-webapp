# Supabase Postgres connection URI (pooler OK for the running API)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Flask / JWT secrets — use long random strings in production
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Browser origins allowed to call the API (comma-separated).
# Local: http://localhost:3000
# Production: your Vercel URL (also set FRONTEND_URL)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional: absolute path for uploaded images (Render disk = /var/data/uploads)
# UPLOAD_ROOT=

# Durable image hosting (recommended in production — survives Render redeploys).
# Create a public bucket named product-images in Supabase Storage, then set:
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Booklist scan (recommended in production — avoids heavy EasyOCR cold start)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional seed accounts (python seed.py)
SEED_ADMIN_EMAIL=smartbookstore@gmail.com
SEED_ADMIN_PASSWORD=Admin123
SEED_ADMIN_NAME=Bookstore Owner
# SEED_EMPLOYEE_EMAIL=
# SEED_EMPLOYEE_PASSWORD=
# SEED_EMPLOYEE_NAME=Bookstore Employee

# Optional customer / staff email notifications (Gmail App Password)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=Smart Books Stationery and Supplies Ltd <you@example.com>
# BOOKSTORE_NOTIFY_EMAIL=
# BOOKSTORE_PHONE=
# MAIL_LOGO_URL=

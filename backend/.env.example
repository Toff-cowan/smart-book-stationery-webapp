# Supabase Postgres connection URI (pooler OK for the running API)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Flask / JWT secrets — use long random strings in production
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Include EVERY live frontend URL — CORS rejects Google login otherwise.
# Local: http://localhost:3000
# Production example (both Vercel aliases):
#   FRONTEND_URL=https://smartbookstore.vercel.app
#   CORS_ORIGINS=https://smartbookstore.vercel.app,https://smart-book-stationery-webapp.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional: absolute path for uploaded images (local / Render disk fallback)
# UPLOAD_ROOT=

# Durable image hosting via Cloudinary (recommended — survives Render redeploys).
# Dashboard → Settings → API Keys. Upload returns a secure_url saved to the DB.
# Either set the single URL:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Or the three separate vars:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Supabase project URL + anon key (required for Google customer login bridge).
# Settings → API. Also used as legacy image storage fallback when Cloudinary is unset.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Optional legacy storage fallback:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth is configured in Supabase Auth → Providers → Google.
# Redirect URLs (Supabase Auth → URL Configuration) must include:
#   http://localhost:3000/auth/callback
#   https://YOUR_VERCEL_APP.vercel.app/auth/callback
# Google Cloud authorized redirect URI must be:
#   https://YOUR_PROJECT.supabase.co/auth/v1/callback

# Booklist scan (recommended in production — avoids heavy EasyOCR cold start)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional seed accounts (python seed.py)
SEED_ADMIN_EMAIL=smartbookstore@gmail.com
SEED_ADMIN_PASSWORD=Admin123
SEED_ADMIN_NAME=Bookstore Owner
# SEED_EMPLOYEE_EMAIL=
# SEED_EMPLOYEE_PASSWORD=
# SEED_EMPLOYEE_NAME=Bookstore Employee

# Customer email via n8n → Gmail (HTTPS webhook; works on Render free tier)
#
# n8n workflow:
#   1) Webhook node (POST) → Production URL
#   2) Gmail Send node:
#        To: {{ $json.to }}
#        Subject: {{ $json.subject }}
#        Message (HTML): {{ $json.html }}
#   3) Activate workflow; paste Production URL below
#
# N8N_WEBHOOK_URL=https://your-n8n.host/webhook/smart-bookstore-email
# N8N_WEBHOOK_SECRET=optional-shared-secret
#
# Used as reply-to / from metadata in the webhook payload (Gmail account in n8n sends):
# MAIL_FROM=Smart Books Stationery and Supplies Ltd <you@example.com>
# BOOKSTORE_NOTIFY_EMAIL=
# BOOKSTORE_PHONE=
# Optional override; default is {FRONTEND_URL}/email-logo.png
# MAIL_LOGO_URL=https://smart-book-stationery-webapp.vercel.app/email-logo.png

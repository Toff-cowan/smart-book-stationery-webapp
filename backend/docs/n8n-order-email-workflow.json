{
  "name": "Smart Bookstore — order emails",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smart-bookstore-email",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "smart-bookstore-email"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.to || $json.to }}",
        "subject": "={{ $json.body.subject || $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.body.html || $json.html }}",
        "options": {
          "replyTo": "={{ $json.body.reply_to || $json.reply_to }}"
        }
      },
      "id": "gmail-1",
      "name": "Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [280, 0],
      "notesInFlow": true,
      "notes": "Use Expression mode. Webhook JSON may be under $json or $json.body. To/Reply-To must be bare emails (no Name <email>)."
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Gmail", "type": "main", "index": 0 }]]
    }
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "settings": {
    "executionOrder": "v1"
  }
}
